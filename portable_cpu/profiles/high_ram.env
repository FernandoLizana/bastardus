# High-RAM Ubuntu notebook profile (≥32 GB RAM recommended).
# Loaded automatically by: bash portable_cpu/bin/run_all.sh --profile high_ram
# Or manually: set -a; source portable_cpu/profiles/high_ram.env; set +a

# Parallel Python orchestrator workers (run_all.sh may raise to max(6, nproc-1)).
export PORTABLE_CPU_JOBS="${PORTABLE_CPU_JOBS:-6}"

# Lean build threads: 0 = all cores (lake build without -j cap).
export LEAN_THREADS="${LEAN_THREADS:-0}"

# Merge high-RAM job entries into the default manifest.
export PORTABLE_CPU_EXTRA_MANIFEST="portable_cpu/jobs.manifest.high_ram.json"

# --- TW sweep overrides (documented; high-RAM manifest jobs set CLI flags explicitly) ---
# EXACT_MAX_NODES=18  — push --exact-max-nodes to 18–20 on boundary sweeps (default manifest uses 14–16 + --memory-safe).
# MEMORY_SAFE=0       — omit --memory-safe on tw sweeps (faster; OOM risk on low-RAM machines).
