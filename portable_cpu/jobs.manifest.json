      "command": [
        "portable_cpu/.venv/bin/python",
        "portable_cpu/lib/chunked_tw_sweep.py",
        "--job-id", "tw_exact_n5_n14_baseline",
        "--n-lo", "5", "--n-hi", "14",
        "--no-representative",
        "--exact-max-nodes", "32",
        "--csv", "experiments/chord_treewidth_n5_n14_baseline.csv"
