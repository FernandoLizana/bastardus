{
  "version": 1,
  "description": "Portable CPU jobs for ChordWidth / bastardus. All paths relative to repo root.",
  "defaults": {
    "python": "portable_cpu/.venv/bin/python",
    "lean_threads": 0,
    "retry_delay_sec": 120,
    "max_attempts": 0
  },
  "jobs": [
    {
      "id": "lean_cache_get",
      "title": "Download Mathlib cache (lake exe cache get)",
      "category": "lean",
      "parallel_group": "lean",
      "cpus_hint": 2,
      "estimated_cpu_hours": 1,
      "depends_on": [],
      "checkpoint": false,
      "command": ["bash", "portable_cpu/bin/resume_lean_chordwidth.sh", "--cache-only"]
    },
    {
      "id": "lean_build_chordwidth",
      "title": "Build PNPLab.ChordWidth.Main (resumable)",
      "category": "lean",
      "parallel_group": "lean",
      "cpus_hint": 8,
      "estimated_cpu_hours": 6,
      "depends_on": ["lean_cache_get"],
      "checkpoint": true,
      "command": ["bash", "portable_cpu/bin/resume_lean_chordwidth.sh"]
    },
