def nfClosedUnder (S : List Clause) (w : Nat) (pivots : List Lit) : Bool :=
  pivots.all fun p =>
    S.all fun C =>
      S.all fun D =>
        match resolveOriented C D p with
        | none => true
        | some R => decide (w < clauseWidth R) || S.contains R

theorem nf_mem_of_closed
    {S : List Clause} {w : Nat} {pivots : List Lit}
    (hbool : nfClosedUnder S w pivots = true)
    {C D R : Clause} {p : Lit}
    (hC : C ∈ S) (hD : D ∈ S)
    (hRes : resolveOriented C D p = some R)
    (hw : clauseWidth R ≤ w)
    (hp : p ∈ pivots) :
    R ∈ S := by
  have hpall := (List.all_eq_true.mp hbool) p hp
  have hCall := (List.all_eq_true.mp hpall) C hC
  have hDall := (List.all_eq_true.mp hCall) D hD
  simp only [hRes] at hDall
  have hnotlt : ¬ w < clauseWidth R := Nat.not_lt.mpr hw
  cases hwidth : decide (w < clauseWidth R) with
  | false =>
    simp only [hwidth, Bool.false_or] at hDall
    exact (List.contains_iff_mem).mp hDall
  | true =>
    exact absurd (of_decide_eq_true hwidth) hnotlt

theorem nfG0_closed_bool : nfClosedUnder nfG0Closed 3 nfPivots = true := by
  native_decide

theorem nfG0_lits_in_pivots :
    (nfG0Closed.all fun C => C.all fun lit => decide (lit ∈ nfPivots)) = true := by
  native_decide

theorem nfG0_pivot
    {C D R : Clause} {p : Lit}
    (hC : C ∈ nfG0Closed) (hRes : resolveOriented C D p = some R) :
    p ∈ nfPivots := by
  obtain ⟨_, hpC, _⟩ := resolveOriented_some_mem hRes
  have hCall := (List.all_eq_true.mp nfG0_lits_in_pivots) C hC
  exact of_decide_eq_true ((List.all_eq_true.mp hCall) p hpC)

def nfG0Closure : WidthClosure 3 where
  axioms := nfG0Axioms
  mem := fun C => C ∈ nfG0Closed
  axiom_mem := by
    intro C hC _
    have h : (nfG0Axioms.all fun A => nfG0Closed.contains A) = true := by
      native_decide
    exact (List.contains_iff_mem).mp ((List.all_eq_true.mp h) C hC)
  closed := by
    intro C D R p hC hD hRes hw
    exact nf_mem_of_closed nfG0_closed_bool hC hD hRes hw (nfG0_pivot hC hRes)

theorem nfG0_no_empty : ¬ nfG0Closure.mem [] := by
  simp [nfG0Closure]
  native_decide


