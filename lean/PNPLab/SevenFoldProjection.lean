  linkedChainCons vfLink12
    (linkedChainCons vfLink23
    (linkedChainCons vfLink34
    (linkedChainCons vfLink45
    (linkedChainCons vfLink56
    (linkedChainCons vfLink6R
    (LinkedChain.singleton vfStep6R))))))

/-- G0 → R via generic `projectionOfLinkedChain` fold over `vfLinked`. -/
def vfProjection : ProjectionInclusion 3 :=
