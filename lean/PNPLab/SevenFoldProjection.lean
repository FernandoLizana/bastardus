def vfProj01OK : Bool :=
  vfG0Closed.all fun C =>
    !(supportedOn C vfV1) || vfG1Closed.contains C

theorem vfProj01OK_true : vfProj01OK = true := by native_decide

theorem vf_supported_01
    {C : Clause} (hG : C ∈ vfG0Closed) (hsup : supportedOn C vfV1 = true) :
    C ∈ vfG1Closed := by
  have hall := (List.all_eq_true.mp vfProj01OK_true) C hG
  simp only [Bool.or_eq_true, Bool.not_eq_true'] at hall
  cases hall with
  | inl h => exact absurd hsup (by simpa using h)
  | inr h => exact (List.contains_iff_mem).mp h


