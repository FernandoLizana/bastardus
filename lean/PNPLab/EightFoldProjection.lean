def efClosedUnder (S : List Clause) (w : Nat) (pivots : List Lit) : Bool :=
  pivots.all fun p =>
    S.all fun C =>
      S.all fun D =>
        match resolveOriented C D p with
        | none => true
        | some R => decide (w < clauseWidth R) || S.contains R

theorem ef_mem_of_closed
    {S : List Clause} {w : Nat} {pivots : List Lit}
    (hbool : efClosedUnder S w pivots = true)
    {C D R : Clause} {p : Lit}
    (hC : C ∈ S) (hD : D ∈ S)
    (hRes : resolveOriented C D p = some R)
    (hw : clauseWidth R ≤ w)
    (hp : p ∈ pivots) :
    R ∈ S := by
  have hpall := (List.all_eq_true.mp hbool) p hp
  have hCall := (List.all_eq_true.mp hpall) C hC
  have hDall := (List.all_eq_true.mp hCall) D hD
  simp only [hRes] at hDall
  have hnotlt : ¬ w < clauseWidth R := Nat.not_lt.mpr hw
  cases hwidth : decide (w < clauseWidth R) with
  | false =>
    simp only [hwidth, Bool.false_or] at hDall
    exact (List.contains_iff_mem).mp hDall
  | true =>
    exact absurd (of_decide_eq_true hwidth) hnotlt

theorem efG0_closed_bool : efClosedUnder efG0Closed 3 efPivots = true := by
  native_decide

theorem efG0_lits_in_pivots :
    (efG0Closed.all fun C => C.all fun lit => decide (lit ∈ efPivots)) = true := by
  native_decide

theorem efG0_pivot
    {C D R : Clause} {p : Lit}
    (hC : C ∈ efG0Closed) (hRes : resolveOriented C D p = some R) :
    p ∈ efPivots := by
  obtain ⟨_, hpC, _⟩ := resolveOriented_some_mem hRes
  have hCall := (List.all_eq_true.mp efG0_lits_in_pivots) C hC
  exact of_decide_eq_true ((List.all_eq_true.mp hCall) p hpC)

def efG0Closure : WidthClosure 3 where
  axioms := efG0Axioms
  mem := fun C => C ∈ efG0Closed
  axiom_mem := by
    intro C hC _
    have h : (efG0Axioms.all fun A => efG0Closed.contains A) = true := by
      native_decide
    exact (List.contains_iff_mem).mp ((List.all_eq_true.mp h) C hC)
  closed := by
    intro C D R p hC hD hRes hw
    exact ef_mem_of_closed efG0_closed_bool hC hD hRes hw (efG0_pivot hC hRes)

theorem efG0_no_empty : ¬ efG0Closure.mem [] := by
  simp [efG0Closure]
  native_decide


