  bridge := rfl
  nest := efNest7R

def efLinked : LinkedChain 3
    [efStep01, efStep12, efStep23, efStep34, efStep45, efStep56, efStep67, efStep7R] :=
  linkedChainCons efLink12
    (linkedChainCons efLink23
    (linkedChainCons efLink34
    (linkedChainCons efLink45
    (linkedChainCons efLink56
    (linkedChainCons efLink67
    (linkedChainCons efLink7R
    (LinkedChain.singleton efStep7R)))))))

/-- G0 → R via generic `projectionOfLinkedChain` fold over `efLinked`. -/
def efProjection : ProjectionInclusion 3 :=
  projectionOfLinkedChain efLinked

theorem ef_no_empty_of_projection :
    ¬ efProjection.gClosure.mem [] :=
  no_empty_of_projection efProjection efR_no_empty

