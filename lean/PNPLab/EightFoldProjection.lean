def efEliminationChain : EliminationChain 3 where
  steps := [efStep01, efStep12, efStep23, efStep34, efStep45, efStep56, efStep67, efStep7R]
  certDoc := "lean/PNPLab/EightFoldProjection.lean"

theorem efNest12 : varsSubset efV2 efV1 = true := by native_decide
theorem efNest23 : varsSubset efV3 efV2 = true := by native_decide
theorem efNest34 : varsSubset efV4 efV3 = true := by native_decide
theorem efNest45 : varsSubset efV5 efV4 = true := by native_decide
theorem efNest56 : varsSubset efV6 efV5 = true := by native_decide
theorem efNest67 : varsSubset efV7 efV6 = true := by native_decide
