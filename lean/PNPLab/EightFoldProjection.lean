theorem efLink12 : StepLink 3 efStep01 efStep12 where
  bridge := rfl
  nest := efNest12

theorem efLink23 : StepLink 3 efStep12 efStep23 where
  bridge := rfl
  nest := efNest23

theorem efLink34 : StepLink 3 efStep23 efStep34 where
  bridge := rfl
  nest := efNest34

